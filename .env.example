NODE_ENV=development
PORT=5050

MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=OXIUM_DB

ACCESS_TOKEN_SECRET=change-me-at-least-16-chars-long
REFRESH_TOKEN_SECRET=optional-refresh-secret

API_VERSION=v1
CORS_ORIGIN=http://localhost:5173

# Shared secret gateways must send as header: X-Payment-Webhook-Secret
PAYMENT_WEBHOOK_SECRET=change-me-gateway-webhook-secret

RAZORPAY_KEY_ID=
RAZORPAY_SECRET_KEY=

LOG_LEVEL=info

# Firebase optional
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_CREDENTIAL_PATH=
